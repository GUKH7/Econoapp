generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  TELEGRAM
  WHATSAPP
  AUDIO
  CSV
  RECURRENT
  RECEIPT
}

enum DinInsightType {
  ANOMALOUS_EXPENSE
  BALANCE_FORECAST
  RECEIVABLE_REMINDER
  PAYABLE_REMINDER
}

enum DinInsightStatus {
  ACTIVE
  REMINDED
  ACTED
  DISMISSED
  EXPIRED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum FinancialScope {
  PERSONAL
  BUSINESS
}

enum FinancialAccountType {
  BANK
  WALLET
}

enum ScheduledNotificationType {
  BILL_DUE
  INSTALLMENT_DUE
  CREDIT_CARD_DUE
  BUSINESS_RECEIVABLE_DUE
  BUSINESS_PAYABLE_DUE
}

enum WhatsappInboundStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum WhatsappOutboxStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  DEAD_LETTER
}

enum AccountAccessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BusinessEntryType {
  RECEIVABLE
  PAYABLE
}

enum BusinessEntryStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum BusinessCostType {
  VARIABLE
  FIXED
}

enum BusinessContactType {
  CLIENT
  SUPPLIER
  BOTH
}

enum BusinessOfferingType {
  PRODUCT
  SERVICE
}

model User {
  id                     String                          @id @default(uuid()) @db.Uuid
  name                   String
  phone                  String                          @unique
  telegramId             String?                         @unique
  email                  String?                         @unique
  passwordHash           String?
  googleSubject          String?                         @unique
  accessStatus           AccountAccessStatus             @default(PENDING)
  paidUntil              DateTime?                       @db.Timestamptz(6)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(6)
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  channels               SalesChannel[]
  categories             Category[]
  categoryPreferences    CategoryPreference[]
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  accounts               FinancialAccount[]
  creditCards            CreditCard[]
  categoryBudgets        CategoryBudget[]
  whatsappConversation   WhatsappConversation?
  dinActivityEvents      DinActivityEvent[]
  notificationDeliveries ScheduledNotificationDelivery[]
  payments               Payment[]                       @relation("UserPayments")
  paymentsRecorded       Payment[]                       @relation("PaymentRecorder")
  businessEntries        BusinessEntry[]
  businessContacts       BusinessContact[]
  businessOfferings      BusinessOffering[]
  businessSettings       BusinessSettings?
  assistantPreference    AssistantPreference?
  dinInsights            DinInsight[]
}

model AssistantPreference {
  userId                 String   @id @db.Uuid
  audioRepliesEnabled    Boolean  @default(false)
  proactiveAlertsEnabled Boolean  @default(true)
  anomalyAlertsEnabled   Boolean  @default(true)
  forecastAlertsEnabled  Boolean  @default(true)
  quietHoursStart        Int      @default(22)
  quietHoursEnd          Int      @default(8)
  timezone               String   @default("America/Sao_Paulo")
  maxWeeklyAlerts        Int      @default(3)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DinInsight {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            DinInsightType
  status          DinInsightStatus @default(ACTIVE)
  fingerprint     String           @unique
  title           String
  summary         String
  explanation     Json
  metadata        Json
  suggestedAction String?
  actionPayload   Json?
  remindAt        DateTime?        @db.Timestamptz(6)
  lastNotifiedAt  DateTime?        @db.Timestamptz(6)
  actedAt         DateTime?        @db.Timestamptz(6)
  dismissedAt     DateTime?        @db.Timestamptz(6)
  expiresAt       DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, remindAt])
  @@index([userId, lastNotifiedAt])
}

model BusinessOffering {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  type              BusinessOfferingType
  name              String
  estimatedUnitCost Decimal              @default(0) @db.Decimal(15, 4)
  defaultPrice      Decimal?             @db.Decimal(15, 4)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  businessEntries BusinessEntry[]

  @@index([userId, type, name])
}

model BusinessContact {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      BusinessContactType
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @db.Timestamptz(6)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessEntries BusinessEntry[]

  @@index([userId, type, name])
}

model Payment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  recordedById String   @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  paidAt       DateTime @db.Timestamptz(6)
  validUntil   DateTime @db.Timestamptz(6)
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user       User @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([userId, paidAt])
  @@index([validUntil])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SalesChannel {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  feePercent            Decimal                @db.Decimal(15, 4)
  isActive              Boolean                @default(true)
  userId                String                 @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model BusinessEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  contactId           String?              @db.Uuid
  offeringId          String?              @db.Uuid
  quantity            Decimal              @default(1) @db.Decimal(15, 4)
  type                BusinessEntryType
  status              BusinessEntryStatus  @default(PENDING)
  title               String
  counterparty        String
  amount              Decimal              @db.Decimal(15, 4)
  dueDate             DateTime             @db.Timestamptz(6)
  settledAt           DateTime?            @db.Timestamptz(6)
  categoryId          String               @db.Uuid
  accountId           String?              @db.Uuid
  recurrenceFrequency RecurrenceFrequency?
  recurrenceEndDate   DateTime?            @db.Timestamptz(6)
  seriesId            String?              @db.Uuid
  transactionId       String?              @unique @db.Uuid
  notes               String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     BusinessContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  offering    BusinessOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, type, status, dueDate])
  @@index([userId, contactId])
  @@index([userId, offeringId])
  @@index([userId, seriesId, dueDate])
}

model BusinessSettings {
  userId              String   @id @db.Uuid
  taxRate             Decimal  @default(0) @db.Decimal(7, 4)
  taxConfigured       Boolean  @default(false)
  businessType        String?
  salesChannels       String[] @default([])
  recurringExpenses   String[] @default([])
  receivingMethods    String[] @default([])
  revenueGoal         Decimal  @default(0) @db.Decimal(15, 4)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CategoryBudget {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  categoryId  String         @db.Uuid
  scope       FinancialScope @default(PERSONAL)
  month       DateTime       @db.Timestamptz(6)
  amount      Decimal        @db.Decimal(15, 4)
  alertLevel  Int            @default(0)
  lastAlertAt DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, scope, month])
  @@index([userId, scope, month])
}

model Category {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  color                 String                 @default("#6366f1")
  businessCostType      BusinessCostType?
  userId                String                 @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               CategoryBudget[]
  recurringTransactions RecurringTransaction[]
  businessEntries       BusinessEntry[]

  @@index([userId])
}

model CategoryPreference {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  sourceKey    String
  sourceText   String
  categoryName String
  type         TransactionType
  hits         Int             @default(1)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey, type])
  @@index([userId, type])
}

model FinancialAccount {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  type                  FinancialAccountType
  balance               Decimal                @default(0) @db.Decimal(15, 4)
  scope                 FinancialScope         @default(PERSONAL)
  isActive              Boolean                @default(true)
  userId                String                 @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  businessEntries       BusinessEntry[]

  @@index([userId, scope])
}

model CreditCard {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  limit                 Decimal                @default(0) @db.Decimal(15, 4)
  closingDay            Int?
  dueDay                Int?
  scope                 FinancialScope         @default(PERSONAL)
  isActive              Boolean                @default(true)
  userId                String                 @db.Uuid
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, scope])
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  description     String
  amount          Decimal           @db.Decimal(15, 4)
  netAmount       Decimal           @db.Decimal(15, 4)
  type            TransactionType
  source          TransactionSource @default(TELEGRAM)
  scope           FinancialScope    @default(PERSONAL)
  categoryId      String            @db.Uuid
  channelId       String?           @db.Uuid
  offeringId      String?           @db.Uuid
  quantity        Decimal           @default(1) @db.Decimal(15, 4)
  unitCost        Decimal?          @db.Decimal(15, 4)
  accountId       String?           @db.Uuid
  creditCardId    String?           @db.Uuid
  recurringRuleId String?           @db.Uuid
  date            DateTime          @default(now()) @db.Timestamptz(6)
  userId          String            @db.Uuid
  importHash      String?
  sourceEventKey  String?           @unique
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  businessEntry   BusinessEntry?

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel       SalesChannel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  offering      BusinessOffering?     @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  account       FinancialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard    CreditCard?           @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  recurringRule RecurringTransaction? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([userId, importHash])
  @@unique([recurringRuleId, date])
  @@index([userId, date])
  @@index([userId, scope])
  @@index([categoryId])
  @@index([channelId])
  @@index([offeringId])
  @@index([accountId])
  @@index([creditCardId])
  @@index([recurringRuleId])
}

model RecurringTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  description    String
  amount         Decimal             @db.Decimal(15, 4)
  type           TransactionType
  scope          FinancialScope      @default(PERSONAL)
  categoryId     String              @db.Uuid
  channelId      String?             @db.Uuid
  accountId      String?             @db.Uuid
  creditCardId   String?             @db.Uuid
  frequency      RecurrenceFrequency @default(MONTHLY)
  interval       Int                 @default(1)
  startDate      DateTime            @db.Timestamptz(6)
  nextRunAt      DateTime            @db.Timestamptz(6)
  endDate        DateTime?           @db.Timestamptz(6)
  maxOccurrences Int?
  generatedCount Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel      SalesChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  account      FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard   CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, isActive, nextRunAt])
  @@index([categoryId])
  @@index([accountId])
  @@index([creditCardId])
}

model WhatsappConversation {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  phone             String   @unique
  recentMessages    Json     @default("[]")
  pendingText       String?
  pendingType       String?
  pendingStep       String?
  pendingData       Json?
  stateVersion      Int      @default(0)
  appRecentMessages Json     @default("[]")
  appPendingText    String?
  appPendingType    String?
  appPendingStep    String?
  appPendingData    Json?
  appStateVersion   Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityEvents DinActivityEvent[]

  @@index([phone])
}

model DinActivityEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String?   @db.Uuid
  conversationId       String?   @db.Uuid
  phone                String?
  channel              String    @default("WHATSAPP")
  eventType            String
  status               String
  sendStatus           String?
  messageText          String?
  audioTranscription   String?
  replyText            String?
  errorMessage         String?
  payload              Json?
  attempts             Int       @default(0)
  provider             String?
  externalMessageId    String?
  detectedIntent       String?
  confidence           Float?
  aiDurationMs         Int       @default(0)
  processingDurationMs Int?
  executedAction       String?
  errorCode            String?
  promptVersion        String?
  modelVersion         String?
  retentionUntil       DateTime? @db.Timestamptz(6)
  redactedAt           DateTime? @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation WhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([provider, externalMessageId])
  @@index([userId, createdAt])
  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@index([retentionUntil])
}

model WhatsappInboundMessage {
  id                String                 @id @default(uuid()) @db.Uuid
  provider          String
  externalMessageId String
  phone             String
  payload           Json
  status            WhatsappInboundStatus  @default(RECEIVED)
  attempts          Int                    @default(0)
  availableAt       DateTime               @default(now()) @db.Timestamptz(6)
  lockedAt          DateTime?              @db.Timestamptz(6)
  processedAt       DateTime?              @db.Timestamptz(6)
  replyText         String?
  lastError         String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)
  outbox            WhatsappOutboxMessage?

  @@unique([provider, externalMessageId])
  @@index([status, availableAt, createdAt])
  @@index([phone, createdAt])
}

model WhatsappOutboxMessage {
  id                String               @id @default(uuid()) @db.Uuid
  inboundMessageId  String?              @unique @db.Uuid
  phone             String
  message           String
  interactions      Json?
  status            WhatsappOutboxStatus @default(PENDING)
  attempts          Int                  @default(0)
  availableAt       DateTime             @default(now()) @db.Timestamptz(6)
  lockedAt          DateTime?            @db.Timestamptz(6)
  sentAt            DateTime?            @db.Timestamptz(6)
  deliveredAt       DateTime?            @db.Timestamptz(6)
  readAt            DateTime?            @db.Timestamptz(6)
  deadLetteredAt    DateTime?            @db.Timestamptz(6)
  providerMessageId String?              @unique
  lastError         String?
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  inboundMessage WhatsappInboundMessage? @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)

  @@index([status, availableAt, createdAt])
  @@index([phone, createdAt])
}

model ScheduledNotificationDelivery {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @db.Uuid
  type            ScheduledNotificationType
  notificationKey String                    @unique
  dueDate         DateTime                  @db.Timestamptz(6)
  sentAt          DateTime                  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([type, dueDate])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
