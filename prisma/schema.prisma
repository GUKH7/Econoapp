generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  TELEGRAM
  WHATSAPP
  AUDIO
  CSV
  RECURRENT
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum FinancialScope {
  PERSONAL
  BUSINESS
}

enum FinancialAccountType {
  BANK
  WALLET
}

enum ScheduledNotificationType {
  BILL_DUE
  INSTALLMENT_DUE
  CREDIT_CARD_DUE
}

model User {
  id                     String                          @id @default(uuid()) @db.Uuid
  name                   String
  phone                  String                          @unique
  telegramId             String?                         @unique
  email                  String?                         @unique
  passwordHash           String?
  googleSubject          String?                         @unique
  createdAt              DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(6)
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  channels               SalesChannel[]
  categories             Category[]
  categoryPreferences    CategoryPreference[]
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  accounts               FinancialAccount[]
  creditCards            CreditCard[]
  categoryBudgets        CategoryBudget[]
  whatsappConversation   WhatsappConversation?
  dinActivityEvents      DinActivityEvent[]
  notificationDeliveries ScheduledNotificationDelivery[]
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SalesChannel {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  feePercent   Decimal       @db.Decimal(15, 4)
  isActive     Boolean       @default(true)
  userId       String        @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model CategoryBudget {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  categoryId  String         @db.Uuid
  scope       FinancialScope @default(PERSONAL)
  month       DateTime       @db.Timestamptz(6)
  amount      Decimal        @db.Decimal(15, 4)
  alertLevel  Int            @default(0)
  lastAlertAt DateTime?      @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, scope, month])
  @@index([userId, scope, month])
}

model Category {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  color        String           @default("#6366f1")
  userId       String           @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      CategoryBudget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
}

model CategoryPreference {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  sourceKey    String
  sourceText   String
  categoryName String
  type         TransactionType
  hits         Int             @default(1)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey, type])
  @@index([userId, type])
}

model FinancialAccount {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  type         FinancialAccountType
  balance      Decimal              @default(0) @db.Decimal(15, 4)
  scope        FinancialScope       @default(PERSONAL)
  isActive     Boolean              @default(true)
  userId       String               @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, scope])
}

model CreditCard {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  limit        Decimal        @default(0) @db.Decimal(15, 4)
  closingDay   Int?
  dueDay       Int?
  scope        FinancialScope @default(PERSONAL)
  isActive     Boolean        @default(true)
  userId       String         @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, scope])
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  description  String
  amount       Decimal           @db.Decimal(15, 4)
  netAmount    Decimal           @db.Decimal(15, 4)
  type         TransactionType
  source       TransactionSource @default(TELEGRAM)
  scope        FinancialScope    @default(PERSONAL)
  categoryId   String            @db.Uuid
  channelId    String?           @db.Uuid
  accountId    String?           @db.Uuid
  creditCardId String?           @db.Uuid
  recurringRuleId String?        @db.Uuid
  date         DateTime          @default(now()) @db.Timestamptz(6)
  userId       String            @db.Uuid
  importHash   String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel    SalesChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  account    FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  recurringRule RecurringTransaction? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([userId, importHash])
  @@unique([recurringRuleId, date])
  @@index([userId, date])
  @@index([userId, scope])
  @@index([categoryId])
  @@index([channelId])
  @@index([accountId])
  @@index([creditCardId])
  @@index([recurringRuleId])
}

model RecurringTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  description     String
  amount          Decimal             @db.Decimal(15, 4)
  type            TransactionType
  scope           FinancialScope      @default(PERSONAL)
  categoryId      String              @db.Uuid
  channelId       String?             @db.Uuid
  accountId       String?             @db.Uuid
  creditCardId    String?             @db.Uuid
  frequency       RecurrenceFrequency @default(MONTHLY)
  interval        Int                 @default(1)
  startDate       DateTime            @db.Timestamptz(6)
  nextRunAt       DateTime            @db.Timestamptz(6)
  endDate         DateTime?           @db.Timestamptz(6)
  maxOccurrences  Int?
  generatedCount  Int                 @default(0)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel     SalesChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  account     FinancialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard  CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, isActive, nextRunAt])
  @@index([categoryId])
  @@index([accountId])
  @@index([creditCardId])
}

model WhatsappConversation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  phone          String   @unique
  recentMessages Json     @default("[]")
  pendingText    String?
  pendingType    String?
  pendingStep    String?
  pendingData    Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityEvents DinActivityEvent[]

  @@index([phone])
}

model DinActivityEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String?  @db.Uuid
  conversationId     String?  @db.Uuid
  phone              String?
  channel            String   @default("WHATSAPP")
  eventType          String
  status             String
  sendStatus         String?
  messageText        String?
  audioTranscription String?
  replyText          String?
  errorMessage       String?
  payload            Json?
  attempts           Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation WhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([phone, createdAt])
  @@index([status, createdAt])
}

model ScheduledNotificationDelivery {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @db.Uuid
  type            ScheduledNotificationType
  notificationKey String                    @unique
  dueDate         DateTime                  @db.Timestamptz(6)
  sentAt          DateTime                  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([type, dueDate])
}
