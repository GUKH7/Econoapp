generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  TELEGRAM
  WHATSAPP
  AUDIO
}

enum FinancialScope {
  PERSONAL
  BUSINESS
}

enum FinancialAccountType {
  BANK
  WALLET
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  phone                String                @unique
  telegramId           String?               @unique
  email                String?               @unique
  passwordHash         String
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  refreshTokens        RefreshToken[]
  channels             SalesChannel[]
  categories           Category[]
  transactions         Transaction[]
  accounts             FinancialAccount[]
  creditCards          CreditCard[]
  categoryBudgets      CategoryBudget[]
  whatsappConversation WhatsappConversation?
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SalesChannel {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  feePercent   Decimal       @db.Decimal(15, 4)
  isActive     Boolean       @default(true)
  userId       String        @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model CategoryBudget {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  categoryId String         @db.Uuid
  scope      FinancialScope @default(PERSONAL)
  month      DateTime       @db.Timestamptz(6)
  amount     Decimal        @db.Decimal(15, 4)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, scope, month])
  @@index([userId, scope, month])
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  color        String        @default("#6366f1")
  userId       String        @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      CategoryBudget[]

  @@index([userId])
}

model FinancialAccount {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  type         FinancialAccountType
  balance      Decimal              @default(0) @db.Decimal(15, 4)
  scope        FinancialScope       @default(PERSONAL)
  isActive     Boolean              @default(true)
  userId       String               @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, scope])
}

model CreditCard {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  limit        Decimal        @default(0) @db.Decimal(15, 4)
  closingDay   Int?
  dueDay       Int?
  scope        FinancialScope @default(PERSONAL)
  isActive     Boolean        @default(true)
  userId       String         @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, scope])
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  description  String
  amount       Decimal           @db.Decimal(15, 4)
  netAmount    Decimal           @db.Decimal(15, 4)
  type         TransactionType
  source       TransactionSource @default(TELEGRAM)
  scope        FinancialScope    @default(PERSONAL)
  categoryId   String            @db.Uuid
  channelId    String?           @db.Uuid
  accountId    String?           @db.Uuid
  creditCardId String?           @db.Uuid
  date         DateTime          @default(now()) @db.Timestamptz(6)
  userId       String            @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel    SalesChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  account    FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCard CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, scope])
  @@index([categoryId])
  @@index([channelId])
  @@index([accountId])
  @@index([creditCardId])
}

model WhatsappConversation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  phone          String   @unique
  recentMessages Json     @default("[]")
  pendingText    String?
  pendingType    String?
  pendingStep    String?
  pendingData    Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
}
