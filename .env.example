# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/econoapp?schema=public

# JWT
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp Cloud API (Meta Developer Portal)
WHATSAPP_TOKEN=seu_access_token
WHATSAPP_VERIFY_TOKEN=seu_token_de_verificacao
WHATSAPP_APP_SECRET=seu_app_secret
WHATSAPP_PHONE_ID=seu_phone_number_id

# Google Gemini
GEMINI_API_KEY=sua_gemini_api_key

# Telegram Bot API (@BotFather)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token

# Servidor
PORT=3001
NODE_ENV=development
