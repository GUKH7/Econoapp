# Banco de dados local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/econoapp?schema=public"
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=econoapp

# JWT
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Google Gemini
GEMINI_API_KEY=sua_gemini_api_key
# Google OAuth Web Client ID. Use virgula para permitir mais de um client ID no backend.
GOOGLE_CLIENT_ID=seu_client_id_web.apps.googleusercontent.com

# Recuperacao de senha (Gmail SMTP)
# Use uma senha de app do Google, nunca a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=din.app.suporte@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=Din <din.app.suporte@gmail.com>
PASSWORD_RESET_URL=http://localhost:5173/?resetPassword=1

# Telegram Bot API (@BotFather)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token

# WhatsApp Bot API (Oracle)
WHATSAPP_BOT_API_URL=http://64.181.189.107:3001/econoapp
WHATSAPP_BOT_SEND_MESSAGE_PATH=/send-message
WHATSAPP_ADMIN_PHONES=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_BUDGET_ALERT_TOKEN=
WHATSAPP_BUDGET_ALERT_INTERVAL_MINUTES=60
RECURRING_TRANSACTION_INTERVAL_MINUTES=60

# Servidor
PORT=3001
NODE_ENV=development

# CORS
# Em desenvolvimento pode ficar vazio ou '*'. Em producao, informe os dominios permitidos separados por virgula.
CORS_ORIGIN=*
