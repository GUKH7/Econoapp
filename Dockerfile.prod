FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache \
	openssl \
	python3 \
	make \
	g++ \
	cairo-dev \
	pango-dev \
	jpeg-dev \
	giflib-dev \
	pixman-dev

COPY package*.json ./
COPY prisma ./prisma
RUN npm ci
RUN npx prisma generate

COPY . .
RUN npm run build
RUN npm prune --omit=dev

FROM node:20-alpine AS runner

WORKDIR /app

RUN apk add --no-cache \
	openssl \
	cairo \
	pango \
	jpeg \
	giflib \
	pixman \
	libstdc++

COPY package*.json ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY prisma ./prisma
COPY register-paths.cjs ./register-paths.cjs

EXPOSE 3001

CMD ["sh", "-c", "npm run prisma:deploy && npm start"]
